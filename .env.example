# Comic Canvas — environment variables (CLAUDE.md §6)
#
# Copy this file to `.env` at the repo root (gitignored) and fill it in.
# `make dev` fails fast with a clear error naming exactly which required
# variable is missing (task 0.3) — it does not silently limp along.
#
# Required before Phase 12: a Postgres connection (native local, ADR 0009 —
# Neon in prod, ADR 0017) and at least one LLM/ASR/image provider key.
# Everything else below has a working local default (mock providers, local
# storage) until the phase that needs the real thing.

# ============================================================================
# core
# ============================================================================

# Postgres connection string. Dev: native local Postgres 15 + pgvector built
# from source (ADR 0009) — NOT a Supabase project (that was the original
# plan; replaced, ADR 0017, after hitting Supabase's free-tier project
# limits). Prod: Neon (free tier, no card required, native pgvector — ADR
# 0017; Railway/Render/Fly.io were checked live and rejected, see that ADR).
# Required — no default, `make dev` refuses to start without it.
# DATABASE_URL=postgresql://comiccanvas@localhost:5432/comiccanvas

# Local Redis (`brew install redis && brew services start redis`) or an
# Upstash free-tier URL. Required — no default.
# REDIS_URL=redis://localhost:6379/0

ENV=dev
LOG_LEVEL=INFO

# mock: no real auth, a fixed dev user (tests/local iteration).
# clerk: verifies the Clerk JWT (JWKS cached from CLERK_JWKS_URL). ADR 0017
# — replaces the originally-planned Supabase Auth.
AUTH_MODE=mock
# CLERK_SECRET_KEY=sk_...   # not currently read by any code path — only
#                             CLERK_JWKS_URL is needed for JWT verification
#                             (services/api/app/auth.py, task 8.2).
# CLERK_JWKS_URL: derive it from NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY instead
# of looking it up separately — a Clerk publishable key is
# `pk_(test|live)_<base64(frontend-api-domain)>`; base64-decoding the
# part after the prefix gives the Frontend API domain directly (verified
# live against a real instance, task 10.3). Append /.well-known/jwks.json.
# CLERK_JWKS_URL=https://[your-instance].clerk.accounts.dev/.well-known/jwks.json

# ============================================================================
# storage (task 0.2b)
# ============================================================================

# local: LocalFileStorage, files under LOCAL_STORAGE_DIR, served by the API
#   at /media/*. r2: Cloudflare R2 (Phase 12, task 12.6).
STORAGE=local
LOCAL_STORAGE_DIR=.data
# R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
# R2_BUCKET=comiccanvas
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_PUBLIC_BASE=https://media.comiccanvas.example

# CORS (task 10.3): apps/web is a different origin from the API. Default
# matches localhost/127.0.0.1 on any port (next dev picks a free port
# when 3000 is busy); lock to the real Vercel origin in Phase 12.
# CORS_ALLOW_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# ============================================================================
# llm (provider:model per role — Phase 1). One env var flips a role between
# providers; `openai_compat:http://host/v1|model` targets a self-hosted
# (e.g. Modal vLLM) OpenAI-compatible endpoint, Phase 9.
# ============================================================================

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_EXTRACTOR=openai:gpt-4o-mini
LLM_SCRIPT=anthropic:claude-sonnet-4-6
LLM_PROMPTS=openai:gpt-4o-mini
LLM_JUDGE=anthropic:claude-sonnet-4-6
LLM_LOOKCARD=openai:gpt-4o
# LLM_CRITIC=anthropic:claude-haiku-4-5-20251001  # optional — the per-panel vision judge
#   (services/worker/app/critic/judge.py). Falls back to this same default if unset, so an
#   existing .env from before this role existed keeps working with no change.

# Optional prompt version pins (default: latest in services/worker/app/prompts/).
# PROMPT_EXTRACTOR=v2
# PROMPT_SCRIPT=v1
# PROMPT_PROMPTS=v1

# ============================================================================
# asr (Phase 8.3)
# ============================================================================

# groq: whisper-large-v3-turbo. faster_whisper: CPU fallback, no API key.
# mock: canned transcript, used by `make test`.
ASR_PROVIDER=mock
# GROQ_API_KEY=

# ============================================================================
# images (Phase 4)
# ============================================================================

# leonardo | flux | flux_kontext: real generation (money + API keys
# below). mock: MockImageProvider — deterministic placeholder PNGs, used
# by `make test` and by every phase before Phase 4/12. `flux_kontext`
# (task 5.13, ADR 0005) is the character-first reference-based path —
# won the identity gate (task 5.15, 2026-09-15) over the trained
# character LoRA and is this project's real default once a master exists.
IMAGE_PROVIDER=mock
IMAGE_FAST=0
IMAGE_CONCURRENCY=6
MAX_USD_PER_DAY=0.60
# LEONARDO_API_KEY=
# LEONARDO_MODEL_ID=
# apiCreditCost (Leonardo's per-generation response) is in credits, not
# USD — the $/credit rate depends on your billing plan, so it isn't
# derivable from the API response itself. Set this once you know your
# plan's real rate; images/leonardo.py falls back to a placeholder
# (0.01) otherwise, which is NOT a verified number.
# LEONARDO_USD_PER_CREDIT=
# FAL_KEY=
# flux_kontext (`services/worker/app/images/flux_kontext.py`) knobs, all optional —
# defaults shown are what the code falls back to when unset:
# FAL_EDIT_MODEL=fal-ai/flux-2/turbo/edit    # or fal-ai/flux-2/edit (the non-turbo model)
# IMAGE_OUTPUT_EDGE=768                      # longest edge of a generated panel, in px
# IMAGE_REFERENCE_EDGE=768                   # longest edge the master/style reference is
#                                             # downscaled to before upload (billed per megapixel)
# IMAGE_SAME_SEED=1                          # 1: a panel's 3 candidate options share one seed
#                                             # (they differ only in prompt wording); 0: a
#                                             # different seed per option (more variety, noisier
#                                             # for the preference model to learn from)
# IMAGE_OPTIONS=bandit                       # bandit: Thompson-sampled option settings once the
#                                             # preference model has enough taps (preference/
#                                             # bandit.py); anything else: always step one knob
# MASTER_SEEDS_PER_CROP=4                    # ml/identity/master.py — candidate seeds per face
#                                             # crop when designing a character's master image

# ============================================================================
# learning (Phase 9)
# ============================================================================

# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# HF_TOKEN=
HF_REPO=neeraj/comiccanvas-models
# WANDB_API_KEY=

WRITER=base
PROMPTER=base
REWARD_HEAD=hand
GENERATOR=leonardo

# ============================================================================
# web (Phase 10 — apps/web, Next.js public env)
# ============================================================================

# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...  # ADR 0017 — unused since 2026-09-21, sign-in removed
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Single-user local mode (2026-09-21, apps/web/lib/auth.ts): there is no sign-in — the app
# always acts as one fixed account. Must match the id AUTH_MODE=mock is willing to accept as
# a bearer token above (any string works; it's just which rows in your own local Postgres this
# app reads and writes). Leave unset for sensible generic defaults ("local-user" / "You").
NEXT_PUBLIC_DEV_USER_ID=local-user
NEXT_PUBLIC_DEV_USER_NAME=You

# ============================================================================
# observability (Phase 12)
# ============================================================================

# LANGSMITH_API_KEY=
# SENTRY_DSN=
