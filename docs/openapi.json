    "/cast/{person_id}/train": {
      "post": {
        "tags": [
          "cast"
        ],
        "summary": "Train Person",
        "description": "The worker's `train_character_job` builds the look card (task\n5.4's real vision call, needs `app.llm` \u2014 worker-only, see this\nrouter's module docstring) before running `design_master` itself \u2014\nnot done here in `/process` even though it would be more responsive,\nbecause `ml.identity.lookcard`'s `services/worker` sys.path bootstrap\nbreaks once THIS service's own `app` package is already loaded\nfirst (a real conflict, found live running this router for the first\ntime \u2014 `ModuleNotFoundError: No module named 'app.llm'`).",
        "operationId": "train_person_cast__person_id__train_post",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Person Id"
            }
